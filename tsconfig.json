{
  "files": [],
  // paths 在这里重复一份是给工具链看的:shadcn CLI 从根 tsconfig 解析 @/ 别名决定组件落地目录,
  // 而根配置是 solution-style(files 为空 + references),编译本身并不使用这段。
  // 缺了它 CLI 会把 "@/shared/ui" 当成字面目录名。
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
